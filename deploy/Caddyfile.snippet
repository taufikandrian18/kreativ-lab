# Kreative Studio Lab behind an existing Caddy, on the bare IP under /kreative-lab/.
#
# Append this block to the Caddyfile, and mount the web root into the Caddy container:
#   volumes:
#     - /var/www:/srv/www:ro
# then: docker compose up -d --force-recreate caddy
#
# The build's basePath (/kreative-lab) is baked into every URL, but the files on disk
# sit at the root of /var/www/kreativ-lab — handle_path strips the prefix before lookup.
# Everything outside /kreative-lab/ on this address returns 404.
http://43.133.130.148 {
	root * /srv/www/kreativ-lab
	encode zstd gzip
	redir /kreative-lab /kreative-lab/ 308
	handle_path /kreative-lab/* {
		@static path /_next/static/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}/ {path}/index.html
		file_server
	}
	handle {
		respond 404
	}
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
