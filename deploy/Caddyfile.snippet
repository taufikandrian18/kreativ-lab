# Kreative Studio Lab on website.taufikandrian.my.id, one path per site:
#
#   /kreative-lab/               the public site (static files, built by GitHub Actions)
#   /kreative-lab/wp-admin/      WordPress, where the studio edits content
#
# Both live under the one prefix. WordPress answers only for its own paths (wp-admin,
# wp-login.php and the other root .php files, wp-includes, wp-content, wp-json, and the
# ?rest_route= API the build reads); every other path is the static site. The old
# /kreative-lab-cms/ address redirects to the same path under /kreative-lab/.
#
# Caddy allows ONE block per hostname. If website.taufikandrian.my.id already has a
# block for your other sites, paste everything between its braces except `encode` into
# it rather than adding this block a second time. Keep a single
# catch-all `handle` at the end of that block.
#
# On the VPS this goes in /home/ubuntu/n8n/Caddyfile, served by the n8n-caddy-1
# container, which already mounts /var/www at /srv/www and sits on the n8n_default
# network that deploy/wordpress/docker-compose.yml joins. Reload after editing:
#   sudo docker exec -w /etc/caddy n8n-caddy-1 caddy reload --config /etc/caddy/Caddyfile
# The Caddyfile is bind-mounted as a single file: edit it in place (nano, or
# `cat new > Caddyfile`), never replace it with mv, or the container keeps the old one.
#
# HTTPS is automatic once the DNS A record for website.taufikandrian.my.id points at
# this VPS and ports 80 and 443 are open.
website.taufikandrian.my.id {
	encode zstd gzip

	# ── The old CMS address ──────────────────────────────────────────────────────────
	# WordPress used to live at /kreative-lab-cms/. Bookmarks, saved logins and any link
	# still pointing there land on the same path under /kreative-lab/. 308 keeps the
	# method, so a login form posted to the old address still logs in. The inner `route`
	# keeps the two lines in this order (on their own, redir would run before the strip);
	# the outer `handle` keeps it ahead of the catch-all 404 below, which a bare `route`
	# is sorted after.
	@oldcms path /kreative-lab-cms /kreative-lab-cms/*
	handle @oldcms {
		route {
			uri strip_prefix /kreative-lab-cms
			redir * /kreative-lab{uri} 308
		}
	}

	redir /kreative-lab /kreative-lab/ 308

	handle /kreative-lab/* {
		# ── WordPress ────────────────────────────────────────────────────────────────
		# WordPress's own paths. `*.php` covers wp-login.php, xmlrpc.php, wp-cron.php and
		# index.php at the root; the directories cover the admin and its assets.
		@wp path /kreative-lab/wp-admin /kreative-lab/wp-admin/* /kreative-lab/wp-includes/* /kreative-lab/wp-content/* /kreative-lab/wp-json /kreative-lab/wp-json/* /kreative-lab/*.php
		# The REST API as the build reads it: /kreative-lab/?rest_route=/wp/v2/... Only that
		# query goes to WordPress; any other query on the home page (?utm_source=...) is
		# still the static site.
		@wprest {
			path /kreative-lab/
			query rest_route=*
		}
		# The WordPress files sit in a real kreative-lab directory, on the host at
		# /var/www/ksl-wordpress/kreative-lab, so the URL path is the file path and nothing
		# is rewritten. Caddy serves uploads and admin CSS/JS itself (it sees /var/www as
		# /srv/www) and hands PHP to the ksl-wordpress container, where the same directory
		# is mounted under /var/www/html.
		handle @wp {
			root * /srv/www/ksl-wordpress
			php_fastcgi ksl-wordpress:9000 {
				root /var/www/html
				try_files {path} {path}/index.php /kreative-lab/index.php
			}
			file_server
		}
		handle @wprest {
			root * /srv/www/ksl-wordpress
			rewrite * /kreative-lab/index.php?{query}
			php_fastcgi ksl-wordpress:9000 {
				root /var/www/html
			}
		}

		# ── The public site ──────────────────────────────────────────────────────────
		# The build's basePath (/kreative-lab) is baked into every URL, but the files sit
		# at the root of /var/www/kreativ-lab, so the prefix is stripped before lookup.
		handle {
			uri strip_prefix /kreative-lab
			root * /srv/www/kreativ-lab
			@static path /_next/static/*
			header @static Cache-Control "public, max-age=31536000, immutable"
			@media path /cms/*
			header @media Cache-Control "public, max-age=604800"
			try_files {path} {path}/ {path}/index.html
			file_server
		}
	}

	handle {
		respond 404
	}

	# The site's own 404 page for missing paths under /kreative-lab/. Caddy only accepts
	# handle_errors at this level, so it is scoped with a matcher instead.
	handle_errors 404 {
		@site path /kreative-lab/*
		handle @site {
			root * /srv/www/kreativ-lab
			rewrite * /404.html
			file_server
		}
	}
}
